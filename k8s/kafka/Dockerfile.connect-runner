# Kafka Connect + Iceberg Sink 러너 이미지 (학습 PoC)
# 빌드: podman build -f k8s/kafka/Dockerfile.connect-runner -t localhost:5001/connect-runner:0.1.0 k8s/kafka
#
# 버전 짝맞춤:
#   - 베이스는 Strimzi Kafka 이미지 `<strimzi>-kafka-<kafka>` — Strimzi 1.3.0 / Kafka 4.3.1(kafka-kraft.yaml과 한 벌).
#   - Iceberg는 **1.11.0** — Spark·Flink 러너와 같은 버전이어야 같은 카탈로그를 같은 규칙으로 쓴다.
#
# 🔴 Maven의 `iceberg-kafka-connect` jar를 쓰지 않고 **소스에서 배포 zip을 빌드**한다.
#   - `iceberg-kafka-connect-runtime`은 Maven에 없다(404). `iceberg-kafka-connect`는 1.11.0이 있으나
#     의존성을 품은 플러그인 배포인지 확인하지 못했다.
#   - 공식 문서(1.11.0 kafka-connect.md)는 `./gradlew -x test -x integrationTest clean build`로 만든
#     `kafka-connect/kafka-connect-runtime/build/distributions`의 zip을 플러그인 디렉터리에 두라고 안내한다.
#   ⇒ 문서가 안내하는 경로를 그대로 따른다. 대가는 빌드 시간이다(전 모듈 컴파일).
#   - JDBC 드라이버는 배포 zip에 **포함되지 않는다**(같은 문서) → Postgres 드라이버를 따로 넣는다.

# 배포 zip은 Hive Metastore 포함/미포함 2종이다 — **미포함**을 쓴다(JDBC 카탈로그라 HMS 불필요).
# 소스는 태그 아카이브를 ADD로 받는다(빌더에 git·unzip을 apt로 들이지 않는다 — 버전 고정 불가 패키지를 늘리지 않는다).
# zip 해제는 JDK에 들어 있는 `jar`로 한다. 미포함 zip이 0개면 `test -n`에서 빌드가 죽는다.
FROM eclipse-temurin:17-jdk AS build
ARG ICEBERG_VERSION=1.11.0
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ADD https://github.com/apache/iceberg/archive/refs/tags/apache-iceberg-${ICEBERG_VERSION}.tar.gz /tmp/iceberg.tar.gz
WORKDIR /src
RUN set -eux; \
    tar -xzf /tmp/iceberg.tar.gz --strip-components=1; \
    ./gradlew -x test -x integrationTest clean build; \
    zip=""; \
    for z in kafka-connect/kafka-connect-runtime/build/distributions/iceberg-kafka-connect-runtime-"${ICEBERG_VERSION}"*.zip; do \
        case "$z" in *hive*) ;; *) zip="$PWD/$z" ;; esac; \
    done; \
    test -n "$zip"; \
    mkdir -p /out; \
    cd /out; \
    jar xf "$zip"; \
    mv /out/iceberg-kafka-connect-runtime-* /out/iceberg-sink

# Strimzi 이미지는 quay.io에만 있다 — 레지스트리 허용 목록(.hadolint.yaml)을 넓히지 않고 이 줄만 예외로 둔다.
# hadolint ignore=DL3026
FROM quay.io/strimzi/kafka:1.3.0-kafka-4.3.1
ARG POSTGRES_JDBC_VERSION=42.7.4
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# 마지막 RUN은 "복사됐다"를 값으로 확인한다(philosophy.md 원칙 7) — 커넥터·S3FileIO·드라이버가 모두 있어야 한다.
# S3FileIO(iceberg-aws)가 배포 zip에 들어 있는지는 문서로 확인하지 못했다 → 글롭이 0건이면 ls가 실패해 빌드가 죽는다.
USER root
COPY --from=build /out/iceberg-sink /opt/kafka/plugins/iceberg-sink
RUN set -eux; \
    curl -fL -o /opt/kafka/plugins/iceberg-sink/lib/postgresql-${POSTGRES_JDBC_VERSION}.jar \
        "https://repo1.maven.org/maven2/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar"; \
    ls /opt/kafka/plugins/iceberg-sink/lib/iceberg-kafka-connect-*.jar; \
    ls /opt/kafka/plugins/iceberg-sink/lib/iceberg-aws-*.jar; \
    ls /opt/kafka/plugins/iceberg-sink/lib/postgresql-*.jar; \
    chown -R 1001:0 /opt/kafka/plugins/iceberg-sink
USER 1001
