{
  "description": "pipeline-study Codex 전용 수명주기 가드",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "statusMessage": "저널 번호·열린 미션 확인",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$|^exec$|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/policy_guard.py\"",
            "statusMessage": "비가역 작업 검사",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
