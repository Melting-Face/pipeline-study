# 환경변수 예시 (형식·키만 — 실제 값은 .env에 채우고 커밋하지 않는다)
#
# 사용법: `cp .env.example .env` 후 값 채우기.
# 전파 체인: .env.example → .env → compose.yml(${KEY}) → dg.EnvVar/os.environ
# 상세: docs/operations.md

# --- Postgres (Dagster 메타 스토리지 전용) ---
# 🔴 이제 **메타 DB 전용**이다. Iceberg 카탈로그는 아래 ICEBERG_CATALOG_* 가 따로 가진다.
#   둘은 **다른 DB·다른 롤**이라 값이 갈린다.
#   ⚠️ common/constants.py가 ICEBERG_CATALOG_USER 미지정 시 여기로 폴백하므로,
#     아래 ICEBERG_CATALOG_* 를 비워두면 dagster 계정으로 iceberg DB에 붙어
#     **접속은 되고 테이블 접근에서 거부**된다(부분 성공이라 오진하기 쉽다).
POSTGRES_USER=dagster
POSTGRES_PASSWORD=            # 비밀 — compose `postgres` 메타 DB(호스트 Dagster 전용, Airflow 대체 예정)
POSTGRES_DB=dagster
# 호스트 실행(`uv run dg dev`) 시 접속 좌표. 메타 DB는 compose `postgres` 하나뿐이다
# (`podman compose --profile legacy-meta up -d`, 127.0.0.1:5432 게시). compose 컨테이너도 이 값으로
# `postgres:<값>`에 붙으므로 5432로 둔다. 15432는 카탈로그 CNPG port-forward라 dagster DB가 없다
# (docs/operations.md §1-2).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Dagster ---
DAGSTER_PORT=3000            # 호스트 `dg dev` UI 포트
# 🔴 아래 둘은 dagster.yaml이 `env:`로 참조하므로 **비우면 기동이 실패한다**(선택 아님).
# run 동시성. daemon 메모리와 강결합이다(docs/resource-sizing.md §Dagster).
# 호스트는 여유가 있어 크게 잡아도 된다(in-cluster 판본은 철거됐다).
DAGSTER_MAX_CONCURRENT_RUNS=2
# run step 로그를 올릴 SeaweedFS 버킷(S3ComputeLogManager).
# 버킷은 스택 A(terraform/cluster/kind)의 `terraform_data.seaweedfs_buckets`가 만든다
# (`docker_container.seaweedfs`, `terraform apply` — 호스트에서 localhost:8333로 직결).
DAGSTER_COMPUTE_LOG_BUCKET=dagster-logs

# --- AWS / S3 (SeaweedFS S3 호환) ---
AWS_ACCESS_KEY_ID=           # 비밀 — 아래 ICEBERG_S3_ACCESS_KEY와 **같은 값**(다르면 ACCESS_DENIED — 일치를 검사하는 단계는 없다)
AWS_SECRET_ACCESS_KEY=       # 비밀 — 아래 ICEBERG_S3_SECRET_KEY와 **같은 값**
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1         # boto3 세션 리전 — S3ComputeLogManager가 이 키를 본다
# ⚠️ ENDPOINT_URL은 **Dagster 코드가 읽지 않는다**(코드가 보는 키는 ICEBERG_S3_ENDPOINT).
# compose가 컨테이너에 전달할 뿐이다.
ENDPOINT_URL=http://host.containers.internal:8333   # 컨테이너에서 본 S3(스택 A 루프백 게시)

# --- Iceberg 카탈로그: Dagster(pyiceberg)가 적재할 대상 ---
# 미지정 시 compose 기본값(postgres:5432/iceberg_catalog + 메타 DB 계정)을 쓴다.
# K8s 카탈로그를 대상으로 하려면 아래를 채운다(호스트 실행 시 port-forward 주소).
# 코드 참조: common/constants.py · 전환 배경: docs/operations.md §1-2
ICEBERG_CATALOG_HOST=localhost
ICEBERG_CATALOG_PORT=15432
ICEBERG_CATALOG_DB=iceberg
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=    # 비밀 — k8s Secret `catalog-pg-app`의 password와 같은 값

# --- Iceberg 웨어하우스·S3 ---
# 위 카탈로그 PG는 in-cluster라 호스트에서 쓸 때 port-forward가 필요하다.
#   kubectl port-forward svc/catalog-postgres-rw 15432:5432
# S3는 클러스터 밖(스택 A 컨테이너)이라 port-forward 없이 아래 ICEBERG_S3_ENDPOINT로 직결한다.
# (JDBC 키 ICEBERG_JDBC_URI·ICEBERG_PG_*는 소비자가 없어 지웠다 — Flink는 파드 env로 받는다.)
# 카탈로그 PG는 CloudNativePG가 관리한다 → 서비스는 `-rw`(쓰기)·`-ro`(읽기 전용)·`-r`(전체).
# 계정 시크릿은 basic-auth라 키 이름이 username/password로 고정된다.
#   kubectl get secret catalog-pg-app -o jsonpath='{.data.password}' | base64 -d
ICEBERG_WAREHOUSE=s3://warehouse
ICEBERG_S3_ENDPOINT=http://localhost:8333
# 🔴 엔드포인트와 자격증명은 **한 쌍**이다. 아래 두 키가 **단일 출처**다 — 스택 A에 `TF_VAR_s3_access_key`/
# `TF_VAR_s3_secret_key`로 같은 값을 주입하면 `docker_container.seaweedfs`가 컨테이너 내부 s3.json을 만들고
# (호스트 파일 없음), k8s Secret `lakehouse-creds`(파드가 쓰는 키)도 같은 값이어야 한다.
# 어긋나면 카탈로그 나열은 되고 `load_table`에서 ACCESS_DENIED로 죽는다(부분 성공이라
# 원인을 오해하기 쉽다). 미설정이면 공용 AWS_ACCESS_KEY_ID/SECRET으로 폴백한다.
#   kubectl get secret lakehouse-creds -o jsonpath='{.data.s3-access-key}' | base64 -d
ICEBERG_S3_ACCESS_KEY=       # 비밀 — k8s Secret `lakehouse-creds`의 s3-access-key
ICEBERG_S3_SECRET_KEY=       # 비밀 — k8s Secret `lakehouse-creds`의 s3-secret-key
ICEBERG_VERSION=1.11.0       # 러너 이미지와 같은 버전으로 유지

# --- PhysioNet (credentialed 원천 자동 다운로드) ---
# MIMIC-IV·eICU-CRD 원천 csv.gz를 Dagster 수집 자산이 직접 받아온다.
# 코드 참조: common/physionet.py(리소스) · defs/<dataset>/raw_assets.py
#
# 🔴 **서비스 계정이 아니라 DUA에 서명한 *개인*의 크리덴셜이다.**
#    공유·CI 투입은 그 자체가 DUA 위반 경로다(docs/security.md §0).
#    비워두면 정의 로드는 성공하고(EnvVar는 run 시점 해석) **수집 자산 실행에서만**
#    실패한다 — 적재 자산은 이미 S3에 있는 파일로 계속 돈다.
PHYSIONET_USERNAME=          # 비밀 — PhysioNet 계정 ID
PHYSIONET_PASSWORD=          # 비밀 — PhysioNet 계정 비밀번호

# --- 금융 시장 원천 (주식예측 파이프라인) ---
# 코드 참조: defs/polygon_market/ · defs/fred_calendar/ · common/polygon.py · common/fred.py
# 접근성 관문: uv run scripts/stock_source_access_probe.py --source all
#
# 🔴 **원천 데이터는 재배포할 수 없다.** 공개하는 것은 코드와 pull 시점뿐이며,
#    Iceberg 테이블·노트북 출력·리포트를 저장소나 외부로 내보내지 않는다.
#    (Investing.com은 약관이 저장 자체를 금지해 원천에서 제외했다.)
#
# 🔴 비워두면 정의 로드는 성공하고(EnvVar는 run 시점 해석) **자산 실행에서만**
#    실패한다 — 다른 데이터셋의 자산은 계속 돈다.
#
# Polygon은 `Authorization: Bearer`를 지원해 키가 URL에 실리지 않는다.
# 반면 FRED는 `?api_key=`뿐이라 예외 메시지에 URL이 새어나갈 수 있어,
# `common/fred.py`의 `FredResource`가 `raise_masked()`(common/fetch.py)로 예외를 재포장한다.
POLYGON_API_KEY=             # 비밀 — https://polygon.io/dashboard/api-keys
FRED_API_KEY=                # 비밀 — https://fredaccount.stlouisfed.org/apikeys

# --- 취약점 원천 (NVD CVE·Change History) ---
# 코드 참조: images/airflow/dags/nvd_*.py · images/airflow/dags/lakehouse/nvd.py
# 소비 경로: scripts/k8s-secrets.sh → Secret airflow-conn-nvd → Connection `nvd_api`
# 접근성 관문: uv run scripts/nvd_access_probe.py --source all
#
# 🔴 **키는 비워둬도 된다**(키 없는 공개 한도로 돌고 요청 간격만 길어진다).
#    단 **줄 자체는 지우지 않는다** — 프로브와 `scripts/k8s-secrets.sh`가 읽는다.
# NVD는 `apiKey` **HTTP 헤더**로 키를 받아 URL에 실리지 않는다(마스킹 불요).
# CISA KEV 피드는 키가 없고, NVD 키를 그 호스트로 보내지 않는다.
NVD_API_KEY=                 # 비밀 — https://nvd.nist.gov/developers/request-an-api-key

# --- 보안 알림 발신 (GeekNews × NVD/KEV → Discord) ---
# 코드 참조: images/airflow/dags/alerts_*.py · 정본 경계: docs/risk.md §4 예외 ②
# 소비 경로: scripts/k8s-secrets.sh → Secret airflow-conn-discord → Connection `discord_webhook`
#            scripts/k8s-secrets.sh → Secret airflow-alerts-watchlist → Celery worker 파드(전 컨테이너)의 읽기 전용 파일
#            (경로 env ALERTS_WATCHLIST_PATH 와 웹훅 env 는 worker 컨테이너에만)
# 🔴 웹훅은 **본인만 구성원인 비공개 서버·채널**의 것 1개뿐이다. 토큰이 URL **경로**에 있어 URL 전체가 비밀이다.
#    형식: https://discord.com/api/webhooks/<id>/<token> — 다른 호스트면 k8s-secrets.sh 가 멈춘다.
#    URL 을 바꾸는 것은 「수신자 교체」다(예외 ② 재검토 조건) — Secret 을 지우고 다시 돌린 뒤 worker 를 재기동한다.
# 🔴 둘 다 비워도 Secret 은 만들어진다(없으면 Celery worker 파드가 못 뜬다). 그때 발신 DAG 는 fail-closed 로 실패한다.
#    줄 자체는 지우지 않는다 — scripts/k8s-secrets.sh 가 읽는다.
DISCORD_WEBHOOK_URL=         # 비밀 — 본인 비공개 채널의 웹훅 URL
# 관심목록 파일 경로 — **저장소 밖**이어야 한다(저장소 안이면 k8s-secrets.sh 가 거부한다). `~` 시작 가능.
# 형식은 scripts/watchlist.example.yaml 을 저장소 밖으로 복사해 고친다. 비공개 입력이라 Git·이미지에 두지 않는다.
ALERTS_WATCHLIST_FILE=       # 비밀 아님(경로) — 파일 내용은 비공개

# 뉴스 축이 SEC EDGAR로 폴백할 때만 필요하다(비밀 아님).
# 읽는 곳은 Dagster 코드가 아니라 scripts/stock_source_access_probe.py다.
# 🔴 SEC는 **연락처 포함 User-Agent를 정책으로 요구**한다 — 없으면 403이다(실측).
#    개인 연락처라 코드에 박지 않고 여기에 둔다. 예: "your-project you@example.com"
NEWS_RSS_USER_AGENT=         # 비밀 아님 — SEC 폴백 시 연락처 포함 UA

# --- 선택: 코드 기본값 덮어쓰기 ---
# 🔴 기본값을 쓰려면 키를 두지 않는다. 빈 값(`KEY=`)으로 주석을 풀면 기본값 대신 빈 문자열이 들어간다.
# Trino 접속 — HOST·PORT는 common/constants.py와 dbt profiles.yml이 같은 env를 읽는다(한 벌).
# TRINO_USER는 Dagster 코드만 읽는다(profiles.yml은 user: dagster 고정).
# TRINO_HOST=trino.localtest.me
# TRINO_PORT=8080
# TRINO_USER=dagster
# DBT_TARGET=dev            # dbt profiles.yml target (dev·prod)
# Flink 세션 자산(defs/flink/constants.py) · Spark PoC 자산(defs/poc/constants.py)
# FLINK_KUBE_CONTEXT=kind-lakehouse
# FLINK_NAMESPACE=default
# FLINK_SESSION_MANIFEST=<경로>   # 기본: 저장소의 세션 매니페스트 경로
# POC_KUBE_CONTEXT=kind-lakehouse
# POC_NAMESPACE=default
# POC_SPARKAPP_MANIFEST=<경로>    # 기본: 저장소의 SparkApplication 매니페스트 경로

# --- SeaweedFS 호환 (AWS SDK flexible checksum) ---
# 최신 SDK 기본값(when_supported)은 본문을 aws-chunked로 감싸는데 SeaweedFS가 못 푼다.
# 코드에도 기본값을 넣어두었지만, 컨테이너·외부 도구를 위해 여기에도 명시한다.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
